        "Faq": {
          "variants": {
            "WeddingFaq1": {
              "id": "faq",
              "label": "FAQs",
              "titleTop": "Frequently Asked",
              "titleAccent": "Questions",
              "description": "Find quick answers to common questions about our wedding and event services.",
              "image": "/images/faq-mandap.webp",
              "imageAlt": "Lantern-lit aisle leading to a floral mandap with two chairs",
              "items": [
                {
                  "id": "event-types",
                  "question": "What types of events do you plan?",
                  "answer": "We plan and manage a wide range of events, including weddings, engagements, receptions, and other special celebrations."
                },
                {
                  "id": "advance-booking",
                  "question": "How far in advance should I book your services?",
                  "answer": "We recommend booking 6 to 12 months ahead for weddings and 2 to 3 months ahead for smaller events, so we can reserve the best venues and vendors."
                },
                {
                  "id": "custom-packages",
                  "question": "Do you provide customized wedding packages?",
                  "answer": "Yes. Every package is built around your traditions, guest count, style and budget, and you can add or remove services at any time."
                },
                {
                  "id": "indoor-outdoor",
                  "question": "Can you handle both indoor and outdoor events?",
                  "answer": "Absolutely. We plan banquet halls, hotels, gardens, beaches and destination venues, with a weather backup plan for every outdoor event."
                },
                {
                  "id": "budget",
                  "question": "Do you work with a specific budget?",
                  "answer": "We work with your budget, whatever its size. We share a clear cost breakdown up front and suggest options that give you the most value."
                },
                {
                  "id": "vendors",
                  "question": "Will you manage vendors and coordination?",
                  "answer": "Yes. We handle decorators, caterers, photographers, artists and logistics, and our team coordinates everything on the day so you can relax."
                }
              ]
            }
